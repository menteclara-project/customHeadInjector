msgid "plugins.generic.customHeadInjector.displayName"
msgstr "Custom Head Injector"

msgid "plugins.generic.customHeadInjector.description"
msgstr "Allows journal managers to inject custom HTML code, meta tags, CSS styles, links, and Schema.org structured data directly into the <head> element of pages."

msgid "plugins.generic.customHeadInjector.manager.settings"
msgstr "Head Injection Settings"

msgid "plugins.generic.customHeadInjector.manager.settings.description"
msgstr ""
"<p>Use this space to paste plain text code blocks that "
"will be automatically included in the header (<code>&lt;head&gt;</code>) of all journal pages.</p>\n"
"<p>You can include indexing meta tags, custom favicon links, "
"additional CSS stylesheets, verification scripts, or complete JSON-LD blocks for Schema.org.</p>"

msgid "plugins.generic.customHeadInjector.manager.settings.customHeadCode"
msgstr "HTML / Meta / Schema Code for Head"

msgid "plugins.generic.customHeadInjector.manager.settings.customHeadCodeInstructions"
msgstr "Paste here the exact content you wish to inject into the header of the journal pages."